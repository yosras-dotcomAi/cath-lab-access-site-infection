import pandas as pd
import matplotlib.pyplot as plt


data = {
    "Week": ["Week 1", "Week 2", "Week 3", "Week 4"],
    "Total_Patients": [120, 135, 128, 140],
    "Infection_Cases": [5, 8, 6, 10]
}

df = pd.DataFrame(data)

df


df["Infection_Rate (%)"] = (df["Infection_Cases"] / df["Total_Patients"]) * 100

df


average_rate = df["Infection_Rate (%)"].mean()

print("Average Infection Rate:", round(average_rate, 2), "%")


plt.figure()
plt.plot(df["Week"], df["Infection_Rate (%)"])
plt.xlabel("Week")
plt.ylabel("Infection Rate (%)")
plt.title("Monthly Infection Rate Trend")
plt.show()


highest_week = df.loc[df["Infection_Rate (%)"].idxmax()]
print("Highest Infection Week:")
print(highest_week)
